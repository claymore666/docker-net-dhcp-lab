"printf 'netns:'; ip netns list 2>/dev/null | awk '$1 ~ /^[l]abc-/ {printf \"%s \", $1}'; echo; printf 'links:'; ip -o link show | awk -F': ' '$2 ~ /^[l]abc-/ {split($2, n, \"@\"); printf \"%s \", n[1]}'; echo; printf 'procs:'; pgrep -f '[l]abc-' | wc -l; printf 'netem:'; /usr/sbin/tc qdisc show dev eth1 root 2>/dev/null | grep -c netem; printf 'addr:'; ip -4 -o addr show dev eth1 | awk '{printf \"%s \", $4}'; echo; printf 'addr6:'; ip -6 -o addr show dev eth1 scope global permanent | awk '{printf \"%s \", $4}'; echo; printf 'cfg6:/etc/kea/kea-dhcp6.conf:'; sudo base64 -w0 /etc/kea/kea-dhcp6.conf 2>/dev/null || printf '!'; echo; printf 'cfg6:/etc/radvd.conf:'; sudo base64 -w0 /etc/radvd.conf 2>/dev/null || printf '!'; echo; echo 'cfg:'; sudo cat /etc/kea/kea-dhcp4.conf"
