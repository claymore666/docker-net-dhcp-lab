"ip neigh show 10.200.1.150 dev eth1"
"sudo mkdir -p /run/lab && sudo tee /run/lab/forcerenew-send.py >/dev/null <<'LABEOF'\nprint(1)\nLABEOF\n"
"sudo python3 /run/lab/forcerenew-send.py --dst-mac 02:aa:bb:cc:dd:ee --iface eth1 --dst-ip 10.200.1.150 --src-ip 10.200.1.2 --chaddr 02:11:22:33:44:55 --mode signed --client-id 006c61622d663262 --nonce 00112233445566778899aabbccddeeff --ack-replay 7"
## kea SquatAnnounce err=false
# restore err=false
"ip -4 -o addr show dev eth1 | awk '{print $4}'"
"sudo ip netns add labc-squat && sudo ip link add labc-sq0 link eth1 type macvlan mode bridge && sudo ip link set labc-sq0 netns labc-squat && { sudo ip netns exec labc-squat sysctl -qw net.ipv6.conf.labc-sq0.disable_ipv6=1 2>/dev/null || true; } && sudo ip netns exec labc-squat sysctl -qw net.ipv4.icmp_echo_ignore_all=1 && sudo ip netns exec labc-squat ip addr add 10.200.1.231/24 dev labc-sq0 && sudo ip netns exec labc-squat ip link set labc-sq0 up"
"sudo ip netns add labc-probe && sudo ip link add labc-pr0 link eth1 type macvlan mode bridge && sudo ip link set labc-pr0 netns labc-probe && { sudo ip netns exec labc-probe sysctl -qw net.ipv6.conf.labc-pr0.disable_ipv6=1 2>/dev/null || true; } && sudo ip netns exec labc-probe ip link set labc-pr0 up"
"printf 'arp:'; sudo ip netns exec labc-probe arping -D -c 2 -w 3 -I labc-pr0 10.200.1.231 2>&1 | tr '\\n' ' '; echo; printf 'mac:'; sudo ip netns exec labc-squat cat /sys/class/net/labc-sq0/address; printf 'icmp:'; sudo ip netns exec labc-squat sysctl -n net.ipv4.icmp_echo_ignore_all"
"if ip netns list | awk '$1 == \"labc-probe\" {f=1} END {exit !f}'; then for i in 1 2 3 4 5 6; do p=$(sudo ip netns pids labc-probe); [ -z \"$p\" ] && break; sudo kill $p; sleep 0.5; done; p=$(sudo ip netns pids labc-probe); [ -z \"$p\" ] || sudo kill -9 $p; sudo ip netns del labc-probe; fi; sudo ip link del labc-pr0 2>/dev/null; ip netns list | awk '$1 == \"labc-probe\" {f=1} END {exit f}'"
"sudo ip netns exec labc-squat arping -q -U -c 3 -I labc-sq0 10.200.1.231"
"if ip netns list | awk '$1 == \"labc-squat\" {f=1} END {exit !f}'; then for i in 1 2 3 4 5 6; do p=$(sudo ip netns pids labc-squat); [ -z \"$p\" ] && break; sudo kill $p; sleep 0.5; done; p=$(sudo ip netns pids labc-squat); [ -z \"$p\" ] || sudo kill -9 $p; sudo ip netns del labc-squat; fi; sudo ip link del labc-sq0 2>/dev/null; ip netns list | awk '$1 == \"labc-squat\" {f=1} END {exit f}'"
