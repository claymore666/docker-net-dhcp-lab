"sudo tee /etc/kea/kea-dhcp4.conf >/dev/null <<'LABEOF'\n{\n\"Dhcp4\": {\n  \"interfaces-config\": { \"interfaces\": [ \"eth1\" ] },\n  \"control-socket\": { \"socket-type\": \"unix\", \"socket-name\": \"/run/kea/kea4-ctrl-socket\" },\n  \"lease-database\": { \"type\": \"memfile\", \"persist\": true, \"name\": \"/var/lib/kea/kea-leases4.csv\" },\n  \"valid-lifetime\": 3600,\n  \"client-classes\": [\n    { \"name\": \"b5\", \"test\": \"option[60].text == 'lab-class-b5'\" },\n    { \"name\": \"not-b5\", \"test\": \"not member('b5')\" }\n  ],\n  \"hooks-libraries\": [\n    { \"library\": \"/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so\" }\n  ],\n  \"subnet4\": [\n    {\n      \"id\": 1,\n      \"subnet\": \"10.200.1.0/24\",\n      \"pools\": [\n        { \"pool\": \"10.200.1.100 - 10.200.1.200\", \"client-class\": \"not-b5\" },\n        { \"pool\": \"10.200.1.221 - 10.200.1.230\", \"client-class\": \"b5\" }\n      ],\n      \"option-data\": [ { \"name\": \"routers\", \"data\": \"10.200.1.1\" } ],\n      \"reservations\": <?include \"/etc/kea/reservations.json\"?>\n    }\n  ]\n}\n}\nLABEOF\n"
