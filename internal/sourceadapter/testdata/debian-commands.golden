"sudo python3 /run/lab/forcerenew-send.py --dst-mac 02:aa:bb:cc:dd:ee --iface eth1 --dst-ip 10.200.1.150 --src-ip 10.200.1.2 --chaddr 02:11:22:33:44:55 --mode unsigned"
## kea SendForceRenewSigned err=false
