dpkg -s iptables-persistent >/dev/null 2>&1
sudo DEBIAN_FRONTEND=noninteractive apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y iptables-persistent
sudo iptables -A FORWARD -i brl15481a73 -j ACCEPT
sudo ip6tables -A FORWARD -i brl15481a73 -j ACCEPT
sudo iptables -C FORWARD -i brl15481a73 -j ACCEPT
sudo ip6tables -C FORWARD -i brl15481a73 -j ACCEPT
sudo netfilter-persistent save
ip link show brl15481a73
readlink -f /sys/class/net/eth1/master | grep -q '/brl15481a73$'
sudo iptables -C FORWARD -i brl15481a73 -j ACCEPT
sudo ip6tables -C FORWARD -i brl15481a73 -j ACCEPT
sudo docker network create -d net-dhcp-under-test:latest --ipam-driver null -o bridge=brl15481a73 labrun-kea-bridge
sudo docker network rm labrun-kea-bridge
sudo iptables -D FORWARD -i brl15481a73 -j ACCEPT
sudo ip6tables -D FORWARD -i brl15481a73 -j ACCEPT
sudo ip link set eth1 nomaster
sudo ip link del brl15481a73
sudo rm -f /etc/netplan/60-dhcp-bridge.yaml
sudo netplan apply
sudo netfilter-persistent save
